# ProSwisher environment variables: NAMES ONLY. Never commit real values.
# Mode guard (scripts/guard.mjs). preview | production. Default: preview
APP_ENV=preview
# Must stay false. Only honored when APP_ENV=production. Default: false
STRIPE_LIVE_ENABLED=false
# Shows the "Subscribe" placeholder (no checkout is wired). Build-time, public. Default: false
VITE_SUBSCRIBE_ENABLED=false
# Set by Railway automatically; the static server listens on it.
# PORT=

# --- Reserved for a future server-side payments component. NOT read by this build. ---
# Restricted key, server-side only; never prefix with VITE_.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
