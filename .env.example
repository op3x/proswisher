# Environment variables: NAMES ONLY. Never commit real values. Set real values in Railway (server-side only).

# --- Mode guard (scripts/guard.mjs + server/payments.mjs) ---
# preview | production. Default: preview. In preview ONLY sk_test_/rk_test_ keys are accepted; a live key stops the build/server.
APP_ENV=preview
# Product name (working name, pending trademark clearance). Unset => the single default in server/brand.mjs. No logo ships yet.
APP_NAME=Simculus
# Must stay false. Only honored when APP_ENV=production. Default: false
STRIPE_LIVE_ENABLED=false
# Set by Railway automatically.
# PORT=

# --- Stripe Billing (TEST mode). Payments stay DISABLED unless all three are set. Ryan sets these. ---
# Restricted TEST key (rk_test_...), server-side only. Never prefix with VITE_.
# STRIPE_SECRET_KEY=
# Signing secret of the Dashboard webhook endpoint for checkout.session.completed -> https://<host>/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET=
# The $9/month recurring price created by Ryan in the Dashboard (price_...). Code never creates products/prices.
# STRIPE_PRICE_ID=
# Optional: Stripe customer-portal no-code login link (fallback for "Manage or cancel").
# STRIPE_PORTAL_LOGIN_URL=
# Optional: "true" to turn on Stripe Tax in Checkout (requires Stripe Tax set up). Default off.
# STRIPE_AUTOMATIC_TAX=
# Optional: public base URL for Checkout success/cancel redirects. Defaults to https://$RAILWAY_PUBLIC_DOMAIN.
# PUBLIC_BASE_URL=

# --- Geoblock (server/geo.mjs) ---
# MaxMind GeoLite2 City license key. Missing DB (or older than 45 days) => checkout DISABLED (fail closed); public pages stay open.
# MAXMIND_LICENSE_KEY=
# Optional: MaxMind account id (basic auth for the download endpoint).
# MAXMIND_ACCOUNT_ID=
# Optional: where the .mmdb lives (default ./geoip, gitignored).
# GEOIP_DIR=
# Optional: number of trusted proxy hops appending X-Forwarded-For (default 1 = Railway edge). 0 = ignore the header.
# Fewer entries than hops (app reached without the proxy) => the socket address is used.
# TRUSTED_PROXY_HOPS=
# Preview only: skip the IP checks on sign-up/checkout (declared + webhook billing checks still apply).
# Setting it with APP_ENV=production makes the server REFUSE TO START.
# GEO_PREVIEW_BYPASS=

# --- Counting (server/counter.mjs) ---
# Bearer token for GET /admin/stats. Unset => endpoint disabled (404). Ryan sets this.
# ADMIN_TOKEN=
# Optional: directory for counts.json (e.g. a Railway volume mount). Unset => in-memory only.
# STATS_DIR=

# --- Data sources (scripts/providers.py; Larry memo 20). FREE tiers only. Ryan accepts each API's terms and sets the key. ---
# balldontlie Free tier key (games endpoint: schedule + final scores). Unset => pipeline fetches and writes nothing.
# BALLDONTLIE_API_KEY=
# The Odds API free tier key (spreads). Only derived fields are published (median line, book count, time). Unset => Winner-only grading.
# ODDS_API_KEY=
# Optional provider selectors (defaults: balldontlie-free / odds-api-free). Lets us swap vendors/tiers without touching callers.
# SCHEDULE_PROVIDER=
# ODDS_PROVIDER=

# --- Pipeline + private storage (Larry P6/P10). Railway volume mounted at /data (README "First data run"). ---
# Without a volume (or if unset) the server falls back to ephemeral /tmp/proswisher/* and logs it.
# Where the FULL prediction log (member picks + nonces) lives. Never public, never committed. Railway: /data/private
# PREDICTIONS_PRIVATE_DIR=
# Where the pipeline writes the PUBLIC data the server serves at /data (games/predictions/stats/prior.json). Railway: /data/public
# PUBLIC_DATA_DIR=
# Optional: append-only consent records (consent.jsonl: time, raw IP, consent version, price shown, 21+). Kept apart from counting.
# CONSENT_DIR=
# Pipeline runs on server start, then every N minutes. Unset => 60. 0 => on start only. Skips cleanly without BALLDONTLIE_API_KEY.
# PIPELINE_INTERVAL_MIN=
# Local/testing only: "true" => synthetic fixture data in /tmp/proswisher-dryrun (refused in production). Never set on Railway.
# PIPELINE_DRY_RUN=

# --- Legal effective dates (Larry's date rule). YYYY-MM-DD, set on the day each version first goes live in PRODUCTION. ---
# Unset or preview => "Effective on launch". Privacy B and refund: set on the day checkout opens.
# LEGAL_EFFECTIVE_TERMS=
# LEGAL_EFFECTIVE_PRIVACY_A=
# LEGAL_EFFECTIVE_PRIVACY_B=
# LEGAL_EFFECTIVE_REFUND=

# First-party visit counting (Larry memo 21). Off unless exactly "true". Leave off until Larry/Ryan sign off.
COUNTING_ENABLED=

# --- Football (NFL + NCAAF) simulation: scripts/football/, server/football/, server/sim/ ---
# Daily refresh of hard data runs at 04:00 America/Chicago (DST-aware). "false" disables the scheduler.
# FOOTBALL_REFRESH_ENABLED=
# Optional overrides of the schedule (defaults 4 / 0 / America/Chicago).
# FOOTBALL_REFRESH_HOUR=
# FOOTBALL_REFRESH_MINUTE=
# FOOTBALL_REFRESH_TZ=
# CollegeFootballData.com API key (free tier, 1,000 calls/month). Unset => NCAAF is skipped and logged; NFL still runs.
# Raw CFBD responses stay in PREDICTIONS_PRIVATE_DIR and are never published; only derived ratings/sims are served.
# CFBD_API_KEY=
# Our own monthly CFBD call cap (counter in the private dir; refresh + ticker share it). Default 800.
# CFBD_MONTHLY_BUDGET=
# Provider selectors (defaults: nflverse / cfbd). "local" (with NFL_LOCAL_DIR) is for dev/backtests only.
# NFL_DATA_PROVIDER=
# NCAAF_DATA_PROVIDER=
# NFL_LOCAL_DIR=
# Comma list of sources to un-stop after a refusal was resolved (e.g. nflverse,cfbd). Remove after one run.
# FOOTBALL_CLEAR_BLOCKS=
# Force the weekly sim-parameter refit on the next refresh ("1").
# FOOTBALL_REFIT_PARAMS=
# Live-score ticker: NFL via balldontlie (BALLDONTLIE_API_KEY above, 5 req/min free tier) every N seconds while a game is live
# (default 120); without the key, nflverse final scores every 10 minutes. NCAAF via CFBD every N minutes (default 60).
# FOOTBALL_TICKER_NFL_SEC=
# FOOTBALL_TICKER_NCAAF_MIN=
# "false" disables the ticker.
# FOOTBALL_TICKER_ENABLED=
# TODO(Larry): live NFL scores (balldontlie) stay OFF until legal clears the source; see
# research/data-sources-terms.md. Do not set this to true before then.
# FOOTBALL_TICKER_LIVE_CLEARED=false
# Custom-sim API limits: max sims per request (default 5000) and concurrent sims (default 2; busy => 503).
# FOOTBALL_SIM_MAX_N=
# FOOTBALL_SIM_CONCURRENCY=
# Sims per scheduled game for precomputed game pages (default 2000).
# FOOTBALL_GAME_SIMS=
# Assumed NFL-vs-college points gap for cross-level fantasy matchups (entertainment only). Default 30.
# FOOTBALL_LEVEL_GAP_POINTS=
# "false" stops the legacy NBA pipeline (recommended for the football pivot: it shares the balldontlie 5 req/min limit).
# LEGACY_NBA_PIPELINE=
