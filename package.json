{
  "name": "proswisher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "guard": "node scripts/guard.mjs",
    "dev": "vite",
    "prebuild": "node scripts/guard.mjs",
    "build": "tsc -b && vite build",
    "prestart": "node scripts/guard.mjs",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "data": "python3 scripts/update_data.py",
    "data:dry-run": "PUBLIC_DATA_DIR=/tmp/proswisher-dryrun/public PREDICTIONS_PRIVATE_DIR=/tmp/proswisher-dryrun/private python3 scripts/update_data.py --dry-run",
    "test:server": "node --test tests/server/*.test.mjs tests/football/*.test.mjs",
    "test": "node --test tests/server/*.test.mjs tests/football/*.test.mjs && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "geoip": "node scripts/fetch-geoip.mjs",
    "purge:consent": "node server/consent-purge.mjs",
    "consent:sessions-with-ip": "node server/consent-purge.mjs --sessions-with-ip",
    "backtest": "python3 scripts/football/backtest.py --pbp-dir ${NFL_LOCAL_DIR:-/tmp/proswisher/private-data/football/raw/nflverse} && node scripts/football/backtest.mjs",
    "football:refresh": "python3 scripts/football/refresh.py"
  },
  "dependencies": {
    "express": "^5.3.0",
    "maxmind": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "serve": "^14.2.4",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
